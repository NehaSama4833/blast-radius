# LLM_PROVIDER = anthropic | openrouter (default: whichever key is set, Anthropic first)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# model ids: defaults exist for Anthropic; with OpenRouter you MUST set both (its ids look like vendor/model)
LEAD_MODEL=claude-sonnet-5-5
AGENT_MODEL=claude-haiku-5-5
# empty = use embedded falkordblite; otherwise e.g. redis://localhost:6379
FALKORDB_URL=
DISCORD_WEBHOOK_URL=
DAILY_INVESTIGATION_CAP=200
ALLOWED_ORIGINS=http://localhost:5173
# Free option: Google AI Studio key through its OpenAI-compatible endpoint (set both model ids to a Gemini model name)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_API_KEY=
